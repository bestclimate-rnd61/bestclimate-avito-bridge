FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 bm && useradd --uid 10001 --gid bm --no-create-home bm && mkdir -p /data/business-machine/artifacts && chown -R bm:bm /data/business-machine
COPY --chown=bm:bm --chmod=0444 business_machine_worker.py business_machine_adapter.py avito_draft_store.py ./
USER 10001:10001
CMD ["python", "-m", "business_machine_worker"]
